{
  "name": "claude-sandbox",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:America/New_York}"
    }
  },
  // NET_ADMIN/NET_RAW are required for the firewall init script (iptables/ipset).
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "eamodio.gitlens"
      ]
    }
  },
  "remoteUser": "node",
  "mounts": [
    // Persist Claude Code login + shell history across container rebuilds.
    "source=claude-sandbox-config,target=/home/node/.claude,type=volume",
    "source=claude-sandbox-history,target=/commandhistory,type=volume"
  ],
  "containerEnv": {
    // Auth for headless `claude -p` (set either on the host; both skip the
    // interactive login prompt). ANTHROPIC_API_KEY = API billing;
    // CLAUDE_CODE_OAUTH_TOKEN (from `claude setup-token`) = subscription billing.
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}",
    // GitHub credentials are intentionally NOT forwarded: the sandbox runs
    // --dangerously-skip-permissions and stays credential-free, so an injected
    // agent has no GitHub token to exfiltrate code with. PR comments are posted
    // from the host by scripts/review-host.sh, which already has gh auth.
    "TZ": "${localEnv:TZ:America/New_York}"
  },
  // Lock down outbound network to the allowlist on every container *start*, not
  // just on create: a stopped container loses its iptables rules, so a plain
  // restart would otherwise come back up wide open. init-firewall.sh is
  // idempotent (it flushes and rebuilds), so re-running it each start is safe.
  // Volume ownership is handled in the image (mount points pre-created owned by node).
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh"
}
